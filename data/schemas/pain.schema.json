{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pain",
  "type": "object",
  "required": ["pain", "category", "severity"],
  "properties": {
    "pain": {"type": "string"},
    "category": {"type": "string"},
    "product_type": {"type": "string"},
    "target_user": {"type": "string"},
    "frequency": {"type": "string", "enum": ["daily", "weekly", "monthly", "one-time"]},
    "willingness_to_pay": {"type": "string", "enum": ["free", "low", "medium", "high"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "existing_solutions": {"type": ["string", "null"]},
    "app_idea": {"type": "string"},
    "source_title": {"type": "string"},
    "source_url": {"type": "string"},
    "source_engagement": {"type": "object"},
    "language": {"type": "string", "enum": ["en", "ja"]}
  }
}
