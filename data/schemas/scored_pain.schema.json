{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoredPain",
  "type": "object",
  "required": ["pain", "category", "severity", "total_score"],
  "properties": {
    "pain": {"type": "string"},
    "category": {"type": "string"},
    "product_type": {"type": "string"},
    "target_user": {"type": "string"},
    "frequency": {"type": "string", "enum": ["daily", "weekly", "monthly", "one-time"]},
    "willingness_to_pay": {"type": "string", "enum": ["free", "low", "medium", "high"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "existing_solutions": {"type": ["string", "null"]},
    "app_idea": {"type": "string"},
    "source_title": {"type": "string"},
    "source_url": {"type": "string"},
    "source_engagement": {"type": "object"},
    "language": {"type": "string", "enum": ["en", "ja"]},
    "total_score": {"type": "integer", "minimum": 0, "maximum": 60},
    "technical_simplicity": {"type": "integer", "minimum": 1, "maximum": 5},
    "scope": {"type": "integer", "minimum": 1, "maximum": 5},
    "differentiation": {"type": "integer", "minimum": 1, "maximum": 5},
    "community_validation": {"type": "integer", "minimum": 1, "maximum": 5},
    "pain_intensity": {"type": "integer", "minimum": 1, "maximum": 5},
    "revenue_potential": {"type": "integer", "minimum": 1, "maximum": 5},
    "market_signal": {
      "type": "string",
      "enum": ["whitespace", "underserved", "emerging", "competitive"]
    },
    "market_apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string"},
          "rating": {"type": "number"},
          "reviews": {"type": "integer"},
          "price": {"type": "string"}
        }
      }
    }
  }
}
